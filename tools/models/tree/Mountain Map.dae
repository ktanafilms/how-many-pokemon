  <library_effects>
    <effect id="cliff01-effect">
      <profile_COMMON>
        <newparam sid="cliff01gs_png-surface">
          <surface type="2D">
            <init_from>cliff01gs_png</init_from>
          </surface>
        </newparam>
        <newparam sid="cliff01gs_png-sampler">
          <sampler2D>
            <source>cliff01gs_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="cliff01gs_png-sampler" texcoord="texcoords"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
